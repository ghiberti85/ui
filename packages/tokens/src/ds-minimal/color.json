{
  "color": {
    "base": {
      "white":        { "$value": "#FFFFFF",   "$type": "color" },
      "black":        { "$value": "#0A0A0A",   "$type": "color" },
      "gray-50":      { "$value": "#FAFAFA",   "$type": "color" },
      "gray-100":     { "$value": "#F4F4F5",   "$type": "color" },
      "gray-200":     { "$value": "#E4E4E7",   "$type": "color" },
      "gray-300":     { "$value": "#D4D4D8",   "$type": "color" },
      "gray-400":     { "$value": "#A1A1AA",   "$type": "color" },
      "gray-500":     { "$value": "#71717A",   "$type": "color" },
      "gray-600":     { "$value": "#52525B",   "$type": "color" },
      "gray-700":     { "$value": "#3F3F46",   "$type": "color" },
      "gray-800":     { "$value": "#27272A",   "$type": "color" },
      "gray-900":     { "$value": "#18181B",   "$type": "color" },
      "accent":       { "$value": "#2563EB",   "$type": "color" },
      "accent-hover": { "$value": "#1D4ED8",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.white}",   "$type": "color" },
      "background-subtle":  { "$value": "{color.base.gray-50}", "$type": "color" },
      "foreground":         { "$value": "{color.base.gray-900}","$type": "color" },
      "foreground-muted":   { "$value": "{color.base.gray-500}","$type": "color" },
      "border":             { "$value": "{color.base.gray-200}","$type": "color" },
      "primary":            { "$value": "{color.base.accent}",  "$type": "color" },
      "primary-hover":      { "$value": "{color.base.accent-hover}", "$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",   "$type": "color" },
      "destructive":            { "$value": "#DC2626",             "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.white}",  "$type": "color" }
    }
  }
}
