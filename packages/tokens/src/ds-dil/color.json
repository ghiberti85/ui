{
  "color": {
    "base": {
      "white":       { "$value": "#ffffff",   "$type": "color" },
      "slate-50":    { "$value": "#f1f5f9",   "$type": "color" },
      "blue-600":    { "$value": "#2462ea",   "$type": "color" },
      "blue-700":    { "$value": "#1d4ed8",   "$type": "color" },
      "blue-400":    { "$value": "#3b82f5",   "$type": "color" },
      "slate-500":   { "$value": "#64748b",   "$type": "color" },
      "slate-400":   { "$value": "#94a3b7",   "$type": "color" },
      "slate-800":   { "$value": "#1e293b",   "$type": "color" },
      "dark-950":    { "$value": "#010816",   "$type": "color" },
      "light-50":    { "$value": "#f7f9fb",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.white}",    "$type": "color" },
      "background-subtle":  { "$value": "{color.base.slate-50}", "$type": "color" },
      "foreground":         { "$value": "{color.base.dark-950}", "$type": "color" },
      "foreground-muted":   { "$value": "{color.base.slate-500}","$type": "color" },
      "border":             { "$value": "#e2e8f0",               "$type": "color" },
      "primary":            { "$value": "{color.base.blue-600}", "$type": "color" },
      "primary-hover":      { "$value": "{color.base.blue-700}", "$type": "color" },
      "primary-foreground": { "$value": "{color.base.light-50}", "$type": "color" },
      "destructive":            { "$value": "#ee4444", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.light-50}", "$type": "color" }
    }
  }
}
