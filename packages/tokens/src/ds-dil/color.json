{
  "color": {
    "base": {
      "black":         { "$value": "#000000",   "$type": "color" },
      "dark-950":      { "$value": "#0b0f1a",   "$type": "color" },
      "dark-900":      { "$value": "#111827",   "$type": "color" },
      "dark-800":      { "$value": "#1f2937",   "$type": "color" },
      "dark-700":      { "$value": "#374151",   "$type": "color" },
      "dark-600":      { "$value": "#4b5563",   "$type": "color" },
      "dark-500":      { "$value": "#6b7280",   "$type": "color" },
      "dark-400":      { "$value": "#9ca3af",   "$type": "color" },
      "dark-300":      { "$value": "#d1d5db",   "$type": "color" },
      "dark-200":      { "$value": "#e5e7eb",   "$type": "color" },
      "dark-100":      { "$value": "#f3f4f6",   "$type": "color" },
      "white":         { "$value": "#f9fafb",   "$type": "color" },
      "indigo-400":    { "$value": "#818cf8",   "$type": "color" },
      "indigo-500":    { "$value": "#6366f1",   "$type": "color" },
      "indigo-600":    { "$value": "#4f46e5",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.dark-950}", "$type": "color" },
      "background-subtle":  { "$value": "{color.base.dark-900}", "$type": "color" },
      "foreground":         { "$value": "{color.base.dark-100}", "$type": "color" },
      "foreground-muted":   { "$value": "{color.base.dark-400}", "$type": "color" },
      "border":             { "$value": "{color.base.dark-700}", "$type": "color" },
      "primary":            { "$value": "{color.base.indigo-500}", "$type": "color" },
      "primary-hover":      { "$value": "{color.base.indigo-600}", "$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",      "$type": "color" },
      "destructive":            { "$value": "#f87171", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.dark-950}", "$type": "color" }
    }
  }
}
