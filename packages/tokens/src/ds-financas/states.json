{
  "color": {
    "state": {
      "success":            { "$value": "#059669", "$type": "color" },
      "success-subtle":     { "$value": "rgba(5,150,105,0.10)",   "$type": "color" },
      "success-foreground": { "$value": "#ffffff", "$type": "color" },
      "warning":            { "$value": "#d97706", "$type": "color" },
      "warning-subtle":     { "$value": "rgba(217,119,6,0.10)",   "$type": "color" },
      "warning-foreground": { "$value": "#ffffff", "$type": "color" },
      "error":              { "$value": "#dc2626", "$type": "color" },
      "error-subtle":       { "$value": "rgba(220,38,38,0.10)",   "$type": "color" },
      "error-foreground":   { "$value": "#ffffff", "$type": "color" },
      "info":               { "$value": "#6c5ce7", "$type": "color" },
      "info-subtle":        { "$value": "rgba(108,92,231,0.10)",  "$type": "color" },
      "info-foreground":    { "$value": "#ffffff", "$type": "color" }
    }
  }
}
