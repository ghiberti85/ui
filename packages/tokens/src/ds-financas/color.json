{
  "color": {
    "base": {
      "white":         { "$value": "#ffffff",   "$type": "color" },
      "gray-50":       { "$value": "#f9fafb",   "$type": "color" },
      "gray-100":      { "$value": "#f3f4f6",   "$type": "color" },
      "gray-200":      { "$value": "#e5e7eb",   "$type": "color" },
      "gray-300":      { "$value": "#d1d5db",   "$type": "color" },
      "gray-400":      { "$value": "#9ca3af",   "$type": "color" },
      "gray-500":      { "$value": "#6b7280",   "$type": "color" },
      "gray-600":      { "$value": "#4b5563",   "$type": "color" },
      "gray-700":      { "$value": "#374151",   "$type": "color" },
      "gray-800":      { "$value": "#1f2937",   "$type": "color" },
      "dark-bg":       { "$value": "#16171d",   "$type": "color" },
      "dark-border":   { "$value": "#2e303a",   "$type": "color" },
      "dark-muted":    { "$value": "#9ca3af",   "$type": "color" },
      "purple-400":    { "$value": "#c084fc",   "$type": "color" },
      "purple-500":    { "$value": "#aa3bff",   "$type": "color" },
      "purple-600":    { "$value": "#9333ea",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.white}",     "$type": "color" },
      "background-subtle":  { "$value": "{color.base.gray-50}",   "$type": "color" },
      "foreground":         { "$value": "{color.base.gray-700}",  "$type": "color" },
      "foreground-muted":   { "$value": "{color.base.gray-500}",  "$type": "color" },
      "border":             { "$value": "{color.base.gray-200}",  "$type": "color" },
      "primary":            { "$value": "{color.base.purple-500}", "$type": "color" },
      "primary-hover":      { "$value": "{color.base.purple-600}", "$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",      "$type": "color" },
      "destructive":            { "$value": "#dc2626", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.white}", "$type": "color" }
    }
  }
}
