{
  "color": {
    "base": {
      "white":        { "$value": "#ffffff",   "$type": "color" },
      "dark-950":     { "$value": "#111113",   "$type": "color" },
      "dark-900":     { "$value": "#17171a",   "$type": "color" },
      "dark-800":     { "$value": "#1c1c20",   "$type": "color" },
      "dark-700":     { "$value": "#222226",   "$type": "color" },
      "light-50":     { "$value": "#fafaf9",   "$type": "color" },
      "light-100":    { "$value": "#f4f4f2",   "$type": "color" },
      "light-200":    { "$value": "#ededeb",   "$type": "color" },
      "violet-500":   { "$value": "#7c6aff",   "$type": "color" },
      "violet-600":   { "$value": "#5b47ff",   "$type": "color" },
      "violet-300":   { "$value": "#b0a5ff",   "$type": "color" },
      "gray-400":     { "$value": "#9a9aa8",   "$type": "color" },
      "gray-600":     { "$value": "#606060",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.dark-950}",  "$type": "color" },
      "background-subtle":  { "$value": "{color.base.dark-900}",  "$type": "color" },
      "foreground":         { "$value": "#efefef",                "$type": "color" },
      "foreground-muted":   { "$value": "{color.base.gray-400}",  "$type": "color" },
      "border":             { "$value": "rgba(255,255,255,0.07)", "$type": "color" },
      "primary":            { "$value": "{color.base.violet-500}","$type": "color" },
      "primary-hover":      { "$value": "{color.base.violet-600}","$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",     "$type": "color" },
      "destructive":            { "$value": "#ff6a6a", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.white}", "$type": "color" }
    }
  }
}
