{
  "color": {
    "base": {
      "black":         { "$value": "#000000",   "$type": "color" },
      "slate-950":     { "$value": "#020617",   "$type": "color" },
      "slate-900":     { "$value": "#0f172a",   "$type": "color" },
      "slate-800":     { "$value": "#1e293b",   "$type": "color" },
      "slate-700":     { "$value": "#334155",   "$type": "color" },
      "slate-600":     { "$value": "#475569",   "$type": "color" },
      "slate-500":     { "$value": "#64748b",   "$type": "color" },
      "slate-400":     { "$value": "#94a3b8",   "$type": "color" },
      "slate-300":     { "$value": "#cbd5e1",   "$type": "color" },
      "slate-200":     { "$value": "#e2e8f0",   "$type": "color" },
      "slate-100":     { "$value": "#f1f5f9",   "$type": "color" },
      "white":         { "$value": "#f8fafc",   "$type": "color" },
      "violet-400":    { "$value": "#a78bfa",   "$type": "color" },
      "violet-500":    { "$value": "#7C6AFF",   "$type": "color" },
      "violet-600":    { "$value": "#6d4ef7",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.slate-950}", "$type": "color" },
      "background-subtle":  { "$value": "{color.base.slate-900}", "$type": "color" },
      "foreground":         { "$value": "{color.base.slate-100}", "$type": "color" },
      "foreground-muted":   { "$value": "{color.base.slate-400}", "$type": "color" },
      "border":             { "$value": "{color.base.slate-700}", "$type": "color" },
      "primary":            { "$value": "{color.base.violet-500}", "$type": "color" },
      "primary-hover":      { "$value": "{color.base.violet-600}", "$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",      "$type": "color" },
      "destructive":            { "$value": "#f87171", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.slate-950}", "$type": "color" }
    }
  }
}
