{
  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "sm":   { "$value": "0 0 6px rgba(255,0,204,0.3)", "$type": "shadow" },
    "md":   { "$value": "0 0 12px rgba(255,0,204,0.5)", "$type": "shadow" },
    "lg":   { "$value": "0 0 24px rgba(255,0,204,0.6), 0 0 48px rgba(255,0,204,0.2)", "$type": "shadow" },
    "xl":   { "$value": "0 0 40px rgba(255,0,204,0.7), 0 0 80px rgba(255,0,204,0.3)", "$type": "shadow" }
  }
}
