      "navy-800":   { "$value": "#1a2438", "$type": "color" },
      "gold-500":   { "$value": "#c9a84c", "$type": "color" },
      "gold-400":   { "$value": "#dbb95e", "$type": "color" },
      "cream":      { "$value": "#f5f0e8", "$type": "color" },
      "cream-dark": { "$value": "#e8e0d0", "$type": "color" },
      "warm-gray":  { "$value": "#9a8f7e", "$type": "color" },
