{
  "typography": {
    "font-family": {
      "sans":    { "$value": "'Space Grotesk', monospace", "$type": "fontFamily" },
      "display": { "$value": "'Bebas Neue', sans-serif",   "$type": "fontFamily" }
    },
    "font-size": {
      "xs":  { "$value": "0.75rem",  "$type": "dimension" },
      "sm":  { "$value": "0.875rem", "$type": "dimension" },
      "md":  { "$value": "1rem",     "$type": "dimension" },
      "lg":  { "$value": "1.25rem",  "$type": "dimension" },
      "xl":  { "$value": "1.5rem",   "$type": "dimension" },
      "2xl": { "$value": "2rem",     "$type": "dimension" },
      "3xl": { "$value": "3rem",     "$type": "dimension" },
      "4xl": { "$value": "5rem",     "$type": "dimension" }
    },
    "font-weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" },
      "black":   { "$value": "900", "$type": "fontWeight" }
    }
  }
}
