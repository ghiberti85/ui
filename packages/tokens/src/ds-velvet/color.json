{
  "color": {
    "base": {
      "white":        { "$value": "#ffffff",   "$type": "color" },
      "lavender-50":  { "$value": "#f4f3ff",   "$type": "color" },
      "purple-500":   { "$value": "#6c5ce7",   "$type": "color" },
      "purple-400":   { "$value": "#7c6af7",   "$type": "color" },
      "purple-600":   { "$value": "#5a4bd1",   "$type": "color" },
      "dark-950":     { "$value": "#0a0a0f",   "$type": "color" },
      "dark-900":     { "$value": "#16151f",   "$type": "color" },
      "dark-800":     { "$value": "#1c1a2e",   "$type": "color" },
      "ink-900":      { "$value": "#1a1830",   "$type": "color" },
      "ink-50":       { "$value": "#f0f0f5",   "$type": "color" }
    },
    "semantic": {
      "background":         { "$value": "{color.base.lavender-50}", "$type": "color" },
      "background-subtle":  { "$value": "rgba(255,255,255,0.55)",   "$type": "color" },
      "foreground":         { "$value": "{color.base.ink-900}",     "$type": "color" },
      "foreground-muted":   { "$value": "rgba(26,24,48,0.4)",       "$type": "color" },
      "border":             { "$value": "rgba(124,106,247,0.12)",   "$type": "color" },
      "primary":            { "$value": "{color.base.purple-500}",  "$type": "color" },
      "primary-hover":      { "$value": "{color.base.purple-600}",  "$type": "color" },
      "primary-foreground": { "$value": "{color.base.white}",       "$type": "color" },
      "destructive":            { "$value": "#dc2626", "$type": "color" },
      "destructive-foreground": { "$value": "{color.base.white}",   "$type": "color" }
    }
  }
}
